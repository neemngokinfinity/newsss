# TGWebDrive — .env template (copy to .env and fill in)
# NEVER commit the real .env. Keep chmod 600.

PORT=3001
HOST=127.0.0.1

# Session secret — generate: openssl rand -hex 32
SECRET=REPLACE_WITH_LONG_RANDOM_HEX

# Public tunnel URL (get from: docker logs cf-tgwd 2>&1 | grep trycloudflare)
PUBLIC_URL=https://your-tunnel-url.trycloudflare.com

# Telegram app credentials from my.telegram.org (format: api_id:api_hash)
API_PRESETS=12345678:abcdef0123456789abcdef0123456789

# Internal service URL for the tunnel container
TUNNEL_URL=http://tgwebdrive:3001
