# VoiceStudio deployment — server-side env template (never commit the real .env)
# Generate the API key server-side:  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'

OMNIVOICE_API_KEY=change-me-generate-server-side
OMNIVOICE_DATA_DIR=/app/omnivoice_data
OMNIVOICE_ANALYTICS_DISABLED=1

# ---- Set AFTER the Cloudflare quick tunnel has started (see DEPLOY-GUIDE.md) ----
OMNIVOICE_ALLOWED_HOSTS=replace-with-tunnel-hostname
OMNIVOICE_ALLOWED_ORIGINS=https://replace-with-tunnel-hostname
