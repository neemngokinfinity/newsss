[Unit]
Description=Nanobot Platform (AI chat + MCP management)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nanobot
Group=nanobot
WorkingDirectory=/opt/nanobot-platform
Environment=PYTHONPATH=/opt/nanobot-platform
Environment=NANOBOT_PLATFORM_DATA=/opt/nanobot-platform/data
Environment=NANOBOT_ADMIN_USER=admin
# Set a strong password, or leave unset to get a generated one in data/admin-password.txt
#Environment=NANOBOT_ADMIN_PASSWORD=change-me
ExecStart=/usr/bin/python3 -m uvicorn server.app:app --host 127.0.0.1 --port 8000 --ws none
Restart=always
RestartSec=3
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
