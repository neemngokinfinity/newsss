# OpenWA second-instance environment — copy to .env next to docker-compose.second.yml
# The .env file itself is NEVER committed (contains secrets).

# Master API key (required). Generate: openssl rand -hex 24
API_MASTER_KEY=
# Pepper for API-key hashing (required). Generate: openssl rand -hex 24
API_KEY_PEPPER=

# Optional: comma-separated allowed CORS origins (default: same-origin)
# CORS_ORIGINS=https://wa.example.com

# Optional: restrict memory (default 2g). whatsapp-web.js uses ~300-500MB per session.
# OPENWA_MEM_LIMIT=2g
