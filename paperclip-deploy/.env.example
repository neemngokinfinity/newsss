# Paperclip AI — environment template (copy to .env, chmod 600)
# Never commit real values.

# Public URL users will access (Cloudflare quick tunnel or fixed domain)
PAPERCLIP_PUBLIC_URL=https://your-public-url.example.com
# Hostnames allowed to serve (comma-separated) — include the public URL host
PAPERCLIP_ALLOWED_HOSTNAMES=your-public-url.example.com,localhost,127.0.0.1

# Auth secret — generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-chars
# Optional: signs agent tool actions — openssl rand -base64 48
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=replace-with-another-long-random-value
