# Obot server configuration
# Copy this file to .env and adjust as needed.

# --- Auth ---
# Enable authentication for Obot
OBOT_SERVER_ENABLE_AUTHENTICATION=true

# Bootstrap token: first-login admin token (required if auth is enabled).
# Must be at least 6 characters. Generate a strong one with:
#   openssl rand -hex 32
# Replace the default for any server that is reachable from outside your LAN.
OBOT_BOOTSTRAP_TOKEN=<change-me-to-a-strong-random-token>

# --- Networking ---
# Obot's own port (container-internal).
OBOT_SERVER_PORT=8080

# Hostname / public URL Obot should use for OAuth redirects, LLM proxying, and invoke URLs.
# REQUIRED if the UI is reachable via a public address (e.g. a Cloudflare quick tunnel or reverse proxy).
# Without it, OAuth sign-in will redirect to localhost and break.
# OBOT_SERVER_HOSTNAME=https://your-public-url.trycloudflare.com

# --- Catalogs (optional) ---
# Default MCP catalogs available to all users
# OBOT_SERVER_DEFAULT_MCPCATALOG_PATH=https://github.com/obot-platform/mcp-catalog/v2-schema
# OBOT_SERVER_DEFAULT_SYSTEM_MCPCATALOG_PATH=https://github.com/obot-platform/system-mcp-catalog/v2-schema

# --- AI providers (optional, only for LLM Gateway) ---
# Uncomment and set at least one:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
